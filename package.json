{
  "name": "@qbrainai/qbrain-ai-cline-v2-plugin",
  "version": "1.121.0",
  "description": "Cline V2 AgentPlugin for QBrain.AI TODO, session-log, requirements, GraphRAG, workspace initialization, and failsafe replay workflows.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./host": {
      "import": "./dist/host.js",
      "types": "./dist/host.d.ts"
    }
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./dist/index.js"
        ],
        "capabilities": [
          "tools",
          "hooks"
        ]
      }
    ]
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "test": "jest",
    "prepublishOnly": "bun run build && bun run test && bun run test:built",
    "test:built": "node --test tests/built-contract.test.mjs"
  },
  "files": [
    "dist/",
    "lib/",
    "skills/",
    "memory-descriptor.json",
    "ENFORCEMENT.md",
    "README.md",
    "CORE-MANIFEST.yaml",
    "vendor/qbrainai-qbrain-ai-plugin-core.tgz",
    "licenses/",
    "guidance/"
  ],
  "keywords": [
    "mcp",
    "cline",
    "cline-plugin",
    "agentplugin",
    "mcpserver",
    "todo",
    "session-log",
    "requirements",
    "graphrag",
    "ai-tools"
  ],
  "author": {
    "name": "Payton Byrd (The Sharp Ninja)",
    "url": "https://github.com/sharpninja"
  },
  "license": "MIT",
  "homepage": "https://github.com/sharpninja/mcpserver-cline-v2-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpninja/mcpserver-cline-v2-plugin.git"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@qbrainai/qbrain-ai-plugin-core": "file:vendor/qbrainai-qbrain-ai-plugin-core.tgz"
  },
  "peerDependencies": {
    "@cline/core": "0.0.92",
    "@cline/sdk": "0.0.92"
  },
  "devDependencies": {
    "@cline/sdk": "0.0.92",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "@cline/core": "0.0.92"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "qbrainGovernance": {
    "version": 1,
    "guidance": [
      "guidance/governed.md"
    ],
    "skills": [
      {
        "id": "clear-session",
        "path": "skills/clear-session/SKILL.md"
      },
      {
        "id": "commit-sync",
        "path": "skills/commit-sync/SKILL.md"
      },
      {
        "id": "handoff",
        "path": "skills/handoff/SKILL.md"
      },
      {
        "id": "memory",
        "path": "skills/memory/SKILL.md"
      },
      {
        "id": "reddit-draft",
        "path": "skills/reddit-draft/SKILL.md"
      },
      {
        "id": "reddit-publish",
        "path": "skills/reddit-publish/SKILL.md"
      },
      {
        "id": "sync-logs",
        "path": "skills/sync-logs/SKILL.md"
      },
      {
        "id": "triage",
        "path": "skills/triage/SKILL.md"
      },
      {
        "id": "workspace",
        "path": "skills/workspace/SKILL.md"
      },
      {
        "id": "wrap-up",
        "path": "skills/wrap-up/SKILL.md"
      }
    ]
  },
  "qbrainAiLegacyName": "@sharpninja/mcpserver-cline-v2-plugin"
}
